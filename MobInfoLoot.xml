<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Frame name="MobInfoLootFrame" toplevel="true" enableMouse="true" movable="true" parent="UIParent" hidden="true">
        <Size x="440" y="540"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets left="11" right="12" top="12" bottom="11"/>
            <TileSize val="32"/>
            <EdgeSize val="32"/>
        </Backdrop>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormal" text="MobInfoLoot">
                    <Anchors>
                        <Anchor point="TOP" x="0" y="-15"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-5" y="-5"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        self:GetParent():Hide();
                    </OnClick>
                </Scripts>
            </Button>

            <!-- Строка поиска -->
            <EditBox name="$parentSearchBox" autoFocus="false" letters="50" historyLines="0">
                <Size x="380" y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="22" y="-38"/>
                </Anchors>
                <FontString inherits="ChatFontNormal"/>
                <Scripts>
                    <OnEscapePressed>self:ClearFocus();</OnEscapePressed>
                </Scripts>
            </EditBox>

            <!-- Кнопки сортировки -->
            <Button name="$parentSortChance" inherits="UIPanelButtonTemplate">
                <Size x="90" y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="22" y="-62"/>
                </Anchors>
                <TextString>Шанс ▼</TextString>
            </Button>
            <Button name="$parentSortName" inherits="UIPanelButtonTemplate">
                <Size x="90" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentSortChance" relativePoint="RIGHT" x="5" y="0"/>
                </Anchors>
                <TextString>Имя</TextString>
            </Button>
            <Button name="$parentFilterLow" inherits="UIPanelButtonTemplate">
                <Size x="120" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentSortName" relativePoint="RIGHT" x="5" y="0"/>
                </Anchors>
                <TextString>Скрыть &lt;1%</TextString>
            </Button>

            <!-- Окно прокрутки -->
            <ScrollFrame name="$parentScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="20" y="-90"/>
                    <Anchor point="BOTTOMRIGHT" x="-35" y="20"/>
                </Anchors>
                <ScrollChild>
                    <Frame name="$parentScrollChild">
                        <Size x="360" y="10"/>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
        <Scripts>
            <OnMouseDown>self:StartMoving();</OnMouseDown>
            <OnMouseUp>self:StopMovingOrSizing();</OnMouseUp>
        </Scripts>
    </Frame>
</Ui>